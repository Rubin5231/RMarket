				<Name>find</Name>
				<Source><![CDATA[
    public static RMarketConditionGroup find(RecId      _recId,
                                             boolean    _forUpdate = false)
    {
        RMarketConditionGroup marketConditionGroup;
        ;
        if (_recId)
        {
            marketConditionGroup.selectForUpdate(_forUpdate);
            
            select firstonly marketConditionGroup
                where marketConditionGroup.RecId  == _recId;
        }
        
        return marketConditionGroup;
    }

]]></Source>
