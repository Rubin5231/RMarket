    public static RMarketSignalSetup find(RMarketSignalType  _signalType,
                                          boolean            _forUpdate = false)
    {
        RMarketSignalSetup signalSetup;
        ;
        signalSetup.selectForUpdate(_forUpdate);
            
        select firstonly signalSetup
            where signalSetup.SignalType  == _signalType;
        
        return signalSetup;
    }

