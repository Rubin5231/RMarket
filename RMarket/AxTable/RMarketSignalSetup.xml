		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static RMarketSignalSetup find(RMarketSignalType  _signalType,
                                          boolean            _forUpdate = false)
    {
        RMarketSignalSetup signalSetup;
        ;
        signalSetup.selectForUpdate(_forUpdate);
            
        select firstonly signalSetup
            where signalSetup.SignalType  == _signalType;
        
        return signalSetup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>signalPriorityDecrease</Name>
				<Source><![CDATA[
    public void signalPriorityDecrease()
    {
        RMarketSignalSetup other;
        
        select firstonly other 
            order by Priority desc
            where other.Priority < this.Priority;

        if (other.RecId)
            RMarketSignalSetup::signalSwapPriority(this, other);
    }

]]></Source>
			</Method>
			<Method>
				<Name>signalPriorityRaise</Name>
				<Source><![CDATA[
    public void signalPriorityRaise()
    {
        RMarketSignalSetup other;
        
        select firstonly other
            order by Priority 
            where other.Priority > this.Priority;

        if (other.RecId)
            RMarketSignalSetup::signalSwapPriority(this, other);
    }

]]></Source>
			</Method>
			<Method>
				<Name>signalSwapPriority</Name>
				<Source><![CDATA[
    public static void signalSwapPriority(RMarketSignalSetup _signal1, RMarketSignalSetup _signal2)
    {
        int num = _signal1.Priority;

        ttsbegin;
        _signal1.Priority = _signal2.Priority;

        _signal2.Priority = maxInt();
        if (_signal2.validateWrite())
            _signal2.Update();
        _signal2.Priority = num;

        if (_signal1.validateWrite())
            _signal1.update();

        if (_signal2.validateWrite())
            _signal2.update();
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void initValue()
    {
        RMarketSignalSetup  RMarketSignalSetup;

        super();

        select maxof(Priority) from RMarketSignalSetup;
        this.Priority = RMarketSignalSetup.Priority + 1;
    }

]]></Source>
