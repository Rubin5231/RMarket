			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find record in the table <t>RMarketSymbolProperty</t>
    /// </summary>
    /// <param name = "_symbolId">a symbolId</param>
    /// <param name = "_marketId">a marketId</param>
    /// <param name = "_forUpdate">if its updatable</param>
    /// <returns>a table <t>RMarketSymbolProperty</t></returns>
    public static RMarketSymbolProperty find(RMarketId        _marketId,
                                             RMarketSymbolId  _symbolId,
                                             boolean          _forUpdate = false)
    {
        RMarketSymbolProperty property;
        ;
        property.selectForUpdate(_forUpdate);
        
        if (_symbolId && _marketId)
        {
            select firstonly property
                where property.SymbolId  == _symbolId &&
                      property.MarketId  == _marketId;
        }
        
        return property;
    }

]]></Source>
			</Method>
			<Method>
				<Name>insertOrUpdate</Name>
				<Source><![CDATA[
    public static void insertOrUpdate(RMarketId        _marketId,
                                      RMarketSymbolId  _symbolId,
                                      container        _dataCon)
    {
        RMarketSymbolProperty property = RMarketSymbolProperty::find(_marketId, _symbolId, true);
        ttsbegin;
        if (!property)
        {
            property.clear();
            property.initValue();
            property.MarketId = _marketId;
            property.SymbolId = _symbolId;
        }
        [
            property.BasePrecision,
            property.QuotePrecision,
            property.MinPrice,
            property.MaxPrice,
            property.StepPrice,
            property.MinMarketQty,
            property.MaxMarketQty,
            property.StepMarketQty,
            property.MinLimitQty,
            property.MaxLimitQty,
            property.StepLimitQty,
            property.MinLimitAmount,
            property.MaxLimitAmount,
            property.MinMarketAmount,
            property.MaxMarketAmount
            ] = _dataCon;

        if (property.validateWrite())
            property.write();
        ttscommit;
    }

]]></Source>
