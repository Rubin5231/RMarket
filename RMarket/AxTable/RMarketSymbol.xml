		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static RMarketSymbol find(RMarketSymbolId   _symbolId,
                                     boolean           _forUpdate = false)
    {
        RMarketSymbol symbol;
        ;
        if (_symbolId)
        {
            symbol.selectForUpdate(_forUpdate);
            
            select firstonly symbol
                where symbol.SymbolId  == _symbolId;
        }
        
        return symbol;
    }

]]></Source>
