		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static RMarketSignalLog find(
        RMarketSubAccountId _subAccountId,
        RefRecId            _actionRecId,
        RMarketTimestamp    _timestamp,
        boolean             _forUpdate = false)
    {
        RMarketSignalLog signalLog;

        signalLog.selectForUpdate(_forUpdate);

        if (_subAccountId && _actionRecId && _timestamp)
        {
            select firstonly signalLog
                where signalLog.SubAccountId               == _subAccountId
                   && signalLog.RMarketStrategyActionRecId == _actionRecId
                   && signalLog.Timestamp                  == _timestamp;
        }

        return signalLog;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(
        RMarketSubAccountId _subAccountId,
        RefRecId            _actionRecId,
        RMarketTimestamp    _timestamp)
    {
        RMarketSignalLog signalLog = RMarketSignalLog::find(_subAccountId, _actionRecId, _timestamp);

        return signalLog.RecId != 0;
    }

]]></Source>
			</Method>
