		<Declaration><![CDATA[
public class RMarketPosition extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
            public static RMarketPosition find(RMarketPositionId  _positionId,
                                       boolean            _forUpdate = false)
    {
        RMarketPosition position;
        ;
        if (_positionId)
        {
            position.selectForUpdate(_forUpdate);
            
            select firstonly position
                where position.PositionId  == _positionId;
        }
        
        return position;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void initValue()
    {
        RMarketPositionId positionId;
        NumberSequenceReference numberSequenceReference;

        super();

        numberSequenceReference = NumberSeqReference::findReference(extendedTypeNum(RMarketPositionId));
        if (numberSequenceReference)
        {
            this.PositionId = NumberSeq::newGetNum(numberSequenceReference).num();
        }
        this.Direction    = RMarketPositionDirection::None;
        this.Status       = RMarketPositionStatus::Created;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromSubAccount</Name>
				<Source><![CDATA[
    public void initFromSubAccount(RMarketSubAccount _subAccount)
    {
        this.SubAccountId = _subAccount.SubAccountId;
        this.AccountId    = _subAccount.AccountId;
        this.SymbolId     = _subAccount.SymbolId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>RMarketAccount</Name>
				<Source><![CDATA[
    public RMarketAccount RMarketAccount(boolean _forUpdate = false)
    {
        return RMarketAccount::find(this.AccountId, _forUpdate);
    }

]]></Source>
			</Method>
