		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static RMarketCategories find(
        RMarketId       _marketId,
        RMarketCategory _category,
        boolean         _forUpdate = false)
    {
        RMarketCategories marketCategories;

        if (_marketId)
        {
            marketCategories.selectForUpdate(_forUpdate);

            select firstonly marketCategories
                where marketCategories.MarketId == _marketId
                   && marketCategories.Category == _category;
        }

        return marketCategories;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateDelete</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// <returns></returns>
    public boolean validateDelete()
    {
        boolean ret = super();

        RMarketDim dim;
        RMarketSymbolIntervals symbolIntervals;
        RMarketSymbolProperty symbolProperty;

        if (ret)
        {
            select firstonly RecId from dim
                where dim.MarketId == this.MarketId
                   && dim.Category == this.Category;

            select firstonly RecId from symbolIntervals
                where symbolIntervals.MarketId == this.MarketId
                   && symbolIntervals.Category == this.Category;

            select firstonly RecId from symbolProperty
                where symbolProperty.MarketId == this.MarketId
                   && symbolProperty.Category == this.Category;

            if (dim.RecId || symbolIntervals.RecId || symbolProperty.RecId)
            {
                ret = checkFailed(strFmt(
                    "Category %1 is in use on market %2.",
                    enum2Str(this.Category),
                    this.MarketId));
            }
        }

        return ret;
    }

]]></Source>
			</Method>
